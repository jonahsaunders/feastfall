{
  "name": "feastfall",
  "version": "0.14.1",
  "description": "A first-person, low-poly battle royale about towers, traps, feasts and long falls.",
  "private": true,
  "main": "desktop/main.js",
  "author": "Jonah Saunders",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "io.github.jonahsaunders.feastfall",
    "productName": "Feastfall",
    "files": [
      "index.html",
      "config.js",
      "server.js",
      "js/**",
      "vendor/**",
      "desktop/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Feastfall-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Feastfall-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "desktop/icon-mac.png",
      "category": "public.app-category.action-games",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Feastfall-${version}-mac.${ext}",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Feastfall connects to games hosted by friends on your local network."
      }
    },
    "dmg": {
      "title": "Feastfall ${version}"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
